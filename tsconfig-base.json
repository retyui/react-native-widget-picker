{
  "compilerOptions": {
    "declaration": true,
    "lib": ["esnext"],
    "moduleResolution": "bundler",
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "rootDir": "src",
    "skipLibCheck": true,
    "strict": true,
    "types": ["react-native"]
  },
  "exclude": ["node_modules", "dist"],
  "include": ["src"]
}
